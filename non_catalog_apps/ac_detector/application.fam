# For details & more options, see documentation/AppManifests.md in firmware repo

App(
    appid="ac_detector",
    name="AC Detector",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="ac_detector_app",
    stack_size=4 * 1024,
    fap_category="Infrared",
    fap_version="1.0",
    fap_icon="ac_detector.png",
    fap_description="Identify the IR protocol an air conditioner remote speaks",
    fap_author="xMasterX",
    fap_libs=["infrared"],
    # tests/ holds a host-side harness built with cc, not the ARM toolchain
    sources=["*.c*", "!tests"],
)
