App(
    appid="subghz_scheduler",
    name="Sub-GHz Scheduler",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="scheduler_app",
    stack_size=5 * 1024,
    fap_category="Sub-GHz",
    fap_version="3.4",
    fap_icon="icons/icon.png",
    fap_icon_assets="icons",
    fap_author="Patrick Edwards",
    fap_weburl="https://github.com/shalebridge/flipper-subghz-scheduler",
    fap_description="Send a single or repeated Sub-GHz signal at a given interval.",
)
